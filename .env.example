# Postgres connection string used by the app and by drizzle-kit.
# Must match the credentials in docker-compose.yml when running the db container locally.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/die_kleinen_einsteins

# Secret used to sign the authentication cookie.
# Use a long, random value in production.
AUTH_SECRET=replace-with-a-long-random-value

# Use false for local HTTP; use true when the app is served over HTTPS.
AUTH_COOKIE_SECURE=false

# Existing app settings (unrelated to the DB work).
SITE_NAME=Die kleinen Einsteins
BASE_PATH=
